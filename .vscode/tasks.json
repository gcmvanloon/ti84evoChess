{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Chess: setup minifier",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\setup_minifier.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "release build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\build_minified.ps1",
                "-Profile",
                "release"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "debug build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\build_minified.ps1",
                "-Profile",
                "debug"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "release metrics",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\measure_profile.ps1",
                "-Profile",
                "release"
            ],
            "problemMatcher": []
        },
        {
            "label": "debug metrics",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\measure_profile.ps1",
                "-Profile",
                "debug"
            ],
            "problemMatcher": []
        }
    ]
}
