{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "release build",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/tools/build_minified.sh",
                "--profile",
                "release"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "debug build",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/tools/build_minified.sh",
                "--profile",
                "debug"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
